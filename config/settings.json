{
  "version": 1,
  "host": "127.0.0.1",
  "request": {
    "timeout_sec": 60,
    "max_retries": 3,
    "backoff_base_ms": 300,
    "backoff_jitter_ms": 200
  },
  "launcher": {
    "health_timeout_sec": 120,
    "health_poll_interval_ms": 500,
    "kill_wait_sec": 5
  },
  "repl": {
    "history_file": "~/.vanitas_history",
    "max_context_tokens": 8192,
    "stream": true
  },
  "tools": {
    "exec_enabled": false,
    "exec_whitelist": ["echo", "dir", "type", "python --version", "git status"],
    "exec_require_confirm": true
  },
  "translate": {
    "source_suffixes": [".txt", ".md", ".srt"],
    "chunk_chars": 1500,
    "output_suffix": ".zh"
  }
}

{
  "version": 1,
  "host": "127.0.0.1",
  "request": {
    "timeout_sec": 60,
    "max_retries": 3,
    "backoff_base_ms": 300,
    "backoff_jitter_ms": 200
  },
  "launcher": {
    "health_timeout_sec": 120,
    "health_poll_interval_ms": 500,
    "kill_wait_sec": 5
  },
  "repl": {
    "history_file": "~/.vanitas/history",
    "max_context_tokens": 8192,
    "stream": true,
    "context_reserve_tokens": 512,
    "min_output_tokens": 256
  },
  "tools": {
    "exec_enabled": true,
    "exec_require_confirm": true
  },
  "translate": {
    "source_suffixes": [".txt", ".md", ".srt"],
    "chunk_chars": 1500,
    "output_suffix": ".zh",
    "context_window": 5,
    "context_summary_chars": 200,
    "min_output_tokens": 512,
    "output_ratio": 2.5,
    "prompt_safety_tokens": 64,
    "monitor_lines": 5
  },
  "ui": {
    "color": "auto",
    "theme": {
      "prompt": "cyan",
      "success": "green",
      "error": "red",
      "warn": "yellow",
      "info": "cyan",
      "muted": "bright_black",
      "accent": "magenta"
    }
  }
}
